<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="mill_accent">#FFFFFF</color>
    <color name="mill_accent_dim">#AAAAAA</color>
    <color name="mill_bg">#121212</color>
    <color name="mill_divider">#2C2C2C</color>
